# Formatting for MatrixOS's own sources. external/ is vendored and stays untouched.
# Derived from the style already present in the repository: 4 spaces, Allman braces.
---
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

BreakBeforeBraces: Allman
PointerAlignment: Right
DerivePointerAlignment: false

# With a 4-space indent, access specifiers belong at column 0.
AccessModifierOffset: -4

# "Inline" keeps trivial accessors defined inside a class on one line, while free
# functions still get the Allman treatment.
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

IncludeBlocks: Preserve
SortIncludes: true

SpaceAfterCStyleCast: true
